{%- comment -%}
  Inline SVG brand logo: painterly paw mark + wordmark.
  Used in the header and footer when no logo image is uploaded.
  Usage: {% render 'brand-logo' %} or {% render 'brand-logo', light: true %}
{%- endcomment -%}
<span class="brand-logo{% if light %} brand-logo--light{% endif %}">
  <svg class="brand-logo__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <ellipse cx="12" cy="17" rx="4.6" ry="5.8" fill="#E4573D" transform="rotate(-14 12 17)"/>
    <ellipse cx="21.5" cy="11.5" rx="4.8" ry="6" fill="#E9A820"/>
    <ellipse cx="31.5" cy="12.5" rx="4.8" ry="6" fill="#2E7F74" transform="rotate(10 31.5 12.5)"/>
    <ellipse cx="40" cy="20" rx="4.4" ry="5.4" fill="#9A6FB8" transform="rotate(24 40 20)"/>
    <path d="M26 22 c7.4 0 14 7 14 13.5 c0 4.9 -3.8 8 -8.6 8 c-2.1 0 -3.7 -1 -5.4 -1 c-1.7 0 -3.3 1 -5.4 1 c-4.8 0 -8.6 -3.1 -8.6 -8 C12 29 18.6 22 26 22 z" fill="#2B2118"/>
    <circle cx="42" cy="38" r="3" fill="#4C86C6"/>
  </svg>
  <span class="brand-logo__word">{{ shop.name }}</span>
</span>
