{%- comment -%}
  Visible breadcrumb trail. Usage: {% render 'breadcrumbs' %}
  Renders on product and collection pages; silent elsewhere.
{%- endcomment -%}
{%- if request.page_type == 'product' or request.page_type == 'collection' -%}
  <nav class="breadcrumbs" aria-label="Breadcrumbs">
    <a href="{{ routes.root_url }}">Home</a>
    {% render 'icon', name: 'chevron-right' %}
    {%- if request.page_type == 'product' -%}
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
      {%- endif -%}
      {% render 'icon', name: 'chevron-right' %}
      <span aria-current="page">{{ product.title }}</span>
    {%- else -%}
      <a href="{{ routes.collections_url }}">Collections</a>
      {% render 'icon', name: 'chevron-right' %}
      <span aria-current="page">{{ collection.title }}</span>
    {%- endif -%}
  </nav>
{%- endif -%}
