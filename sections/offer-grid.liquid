<section class="section">
  <div class="page-width">
    <div class="section-header" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="offer-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign url = block.settings.link | default: collection.url | default: routes.collections_url
          assign title = block.settings.title | default: collection.title | default: 'Offer'
        -%}
        <a href="{{ url }}" class="offer-card offer-card--{{ block.settings.paint }}" data-reveal style="--reveal-delay: {{ forloop.index0 | times: 70 }}ms;" {{ block.shopify_attributes }}>
          <span class="offer-card__icon">
            {%- case block.settings.icon -%}
            {%- when 'portrait' -%}
              <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M10 6 h28 a2 2 0 0 1 2 2 v32 a2 2 0 0 1 -2 2 h-28 a2 2 0 0 1 -2 -2 v-32 a2 2 0 0 1 2 -2 z" stroke="currentColor" stroke-width="2.4"/><circle cx="24" cy="21" r="6.5" fill="currentColor"/><path d="M14 36 c2.5 -5 6 -7.5 10 -7.5 s7.5 2.5 10 7.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
            {%- when 'bandana' -%}
              <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M8 14 Q24 8 40 14 L38 21 Q24 15 10 21 Z" fill="currentColor"/><path d="M11 20 Q24 14 37 20 Q31 32 26 39 Q24 42 22 39 Q17 32 11 20 Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><circle cx="24" cy="27" r="2" fill="currentColor"/></svg>
            {%- when 'book' -%}
              <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M6 12 Q15 8 24 12 L24 38 Q15 34 6 38 Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="M42 12 Q33 8 24 12 L24 38 Q33 34 42 38 Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><circle cx="14" cy="22" r="2.4" fill="currentColor"/><circle cx="33" cy="22" r="2.4" fill="currentColor"/><path d="M11 28 Q15 31 18 28 M30 28 Q34 31 37 28" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            {%- when 'hoodie' -%}
              <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M16 10 Q24 5 32 10 L42 17 L38 24 L34 21 L34 40 Q24 44 14 40 L14 21 L10 24 L6 17 Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="M18 11 Q24 17 30 11" stroke="currentColor" stroke-width="2.4"/><circle cx="24" cy="28" r="5" fill="currentColor"/></svg>
            {%- when 'matching' -%}
              <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M6 12 Q12 15 18 12 L24 16 L21 21 L19 19 L19 32 Q12 35 5 32 L5 19 L3 21 L0 16 Z" fill="currentColor" transform="translate(2 2)"/><path d="M28 16 Q36 13 44 16 L38 30 Q36 32 34 30 Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M22 38 q-2.5 -3 -5 -1 q-2 2 .5 4.5 l4.5 4 l4.5 -4 q2.5 -2.5 .5 -4.5 q-2.5 -2 -5 1 z" fill="currentColor"/></svg>
            {%- when 'pin' -%}
              <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="24" cy="22" r="14" stroke="currentColor" stroke-width="2.4"/><ellipse cx="20" cy="19" rx="1.8" ry="2.3" fill="currentColor"/><ellipse cx="24" cy="17.5" rx="1.8" ry="2.3" fill="currentColor"/><ellipse cx="28" cy="19" rx="1.8" ry="2.3" fill="currentColor"/><path d="M24 22 c3 0 5.5 2.8 5.5 5.3 c0 1.9 -1.5 3.2 -3.4 3.2 c-.8 0 -1.4 -.4 -2.1 -.4 c-.7 0 -1.3 .4 -2.1 .4 c-1.9 0 -3.4 -1.3 -3.4 -3.2 C18.5 24.8 21 22 24 22 z" fill="currentColor"/><path d="M24 36 L24 44 M20 41 L24 44 L28 41" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
            {%- else -%}
              {% render 'icon', name: 'paw' %}
            {%- endcase -%}
          </span>
          <span class="offer-card__title">{{ title }}</span>
          {%- if block.settings.text != blank -%}
            <span class="offer-card__text">{{ block.settings.text }}</span>
          {%- endif -%}
          <span class="offer-card__cta">{{ block.settings.cta | default: 'Explore' }} {% render 'icon', name: 'arrow-right' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Offer grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made from one photo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What comes out of the studio" },
    { "type": "text", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Custom title" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "cta", "label": "Link label", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Custom link" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "portrait", "label": "Portrait" },
            { "value": "bandana", "label": "Bandana" },
            { "value": "book", "label": "Colouring book" },
            { "value": "hoodie", "label": "Hoodie" },
            { "value": "matching", "label": "Matching set" },
            { "value": "pin", "label": "Pin" },
            { "value": "paw", "label": "Paw" }
          ],
          "default": "paw"
        },
        {
          "type": "select",
          "id": "paint",
          "label": "Paint colour",
          "options": [
            { "value": "coral", "label": "Coral" },
            { "value": "teal", "label": "Teal" },
            { "value": "mustard", "label": "Mustard" },
            { "value": "lilac", "label": "Lilac" },
            { "value": "sky", "label": "Sky" },
            { "value": "rose", "label": "Rose" }
          ],
          "default": "coral"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Offer grid",
      "blocks": [
        { "type": "offer", "settings": { "icon": "portrait", "paint": "coral", "title": "Custom Portraits" } },
        { "type": "offer", "settings": { "icon": "bandana", "paint": "teal", "title": "Bandanas" } },
        { "type": "offer", "settings": { "icon": "book", "paint": "lilac", "title": "Colouring eBooks" } }
      ]
    }
  ]
}
{% endschema %}
