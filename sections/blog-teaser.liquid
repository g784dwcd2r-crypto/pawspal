{%- assign blog = blogs[section.settings.blog] -%}

<section class="section">
  <div class="page-width">
    <div class="section-row" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if blog != blank -%}
        <a href="{{ blog.url }}" class="link-arrow section-row__link">Read all {% render 'icon', name: 'arrow-right' %}</a>
      {%- endif -%}
    </div>

    {%- if blog != blank and blog.articles.size > 0 -%}
      <div class="blog-grid" data-reveal style="--reveal-delay: 100ms;">
        {%- for article in blog.articles limit: 3 -%}
          <article class="article-card">
            <div class="article-card__media">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" width="800" height="600">
              {%- else -%}
                <div class="article-card__paint article-card__paint--{{ forloop.index0 | modulo: 3 }}">
                  {% render 'icon', name: 'paw' %}
                </div>
              {%- endif -%}
            </div>
            <p class="article-card__meta">{{ article.published_at | date: '%B %d, %Y' }}</p>
            <h3 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="text-center" style="color: var(--color-text-muted);">Choose a blog in the section settings to feature its latest posts.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog teaser",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Notes & guides" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the sketchbook" },
    { "type": "blog", "id": "blog", "label": "Blog" }
  ],
  "presets": [
    { "name": "Blog teaser" }
  ]
}
{% endschema %}
