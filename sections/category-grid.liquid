<section class="section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="category-grid" style="--cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign title = block.settings.title | default: collection.title | default: 'Category'
          assign url = block.settings.link | default: collection.url | default: routes.all_products_collection_url
          assign image = block.settings.image | default: collection.featured_image
        -%}
        <a href="{{ url }}" class="category-card" {{ block.shopify_attributes }}>
          <div class="category-card__media">
            {%- if image -%}
              <img
                src="{{ image | image_url: width: 600 }}"
                srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 600 }} 600w"
                sizes="(min-width: 990px) 300px, 50vw"
                alt="{{ title | escape }}"
                loading="lazy"
                width="600" height="600">
            {%- else -%}
              {%- assign ph_index = forloop.index0 | modulo: 6 | plus: 1 -%}
              {{ 'collection-' | append: ph_index | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <span class="category-card__title">{{ title }} {% render 'icon', name: 'arrow-right' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "For every good dog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title",
          "info": "Leave blank to use the collection title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Leave blank to use the collection image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        { "type": "category", "settings": { "title": "Collars" } },
        { "type": "category", "settings": { "title": "Leashes" } },
        { "type": "category", "settings": { "title": "Bandanas" } },
        { "type": "category", "settings": { "title": "Toys" } }
      ]
    }
  ]
}
{% endschema %}
