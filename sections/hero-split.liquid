<section class="hero-split">
  <div class="page-width">
    <div class="hero-split__grid">
      <div data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <span class="hero-split__eyebrow">{% render 'icon', name: 'paw' %} {{ section.settings.eyebrow }}</span>
        {%- endif -%}

        <h1 class="hero-split__heading">
          {{ section.settings.heading }}
          {%- if section.settings.heading_accent != blank -%}
            <span class="h-accent">{{ section.settings.heading_accent }}</span>
          {%- endif -%}
        </h1>

        {%- if section.settings.text != blank -%}
          <p class="hero-split__text">{{ section.settings.text }}</p>
        {%- endif -%}

        <div class="hero-split__actions">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="btn btn--primary">
              {{ section.settings.button_label }} {% render 'icon', name: 'arrow-right' %}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 }}" class="btn btn--outline">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>

        <div class="hero-split__chips">
          {%- for block in section.blocks -%}
            <span class="hero-chip" {{ block.shopify_attributes }}>
              {% render 'icon', name: block.settings.icon %} {{ block.settings.text }}
            </span>
          {%- endfor -%}
        </div>
      </div>

      <div class="hero-split__media" data-reveal style="--reveal-delay: 120ms;">
        {%- if section.settings.badge_text != blank -%}
          <span class="hero-split__badge">{% render 'icon', name: 'star' %} {{ section.settings.badge_text }}</span>
        {%- endif -%}

        {%- if section.settings.image != blank -%}
          <div class="hero-split__card">
            <img
              src="{{ section.settings.image | image_url: width: 900 }}"
              srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 44vw, 92vw"
              alt="{{ section.settings.image.alt | default: shop.name | escape }}"
              fetchpriority="high"
              width="900" height="990">
          </div>
        {%- else -%}
          <div class="hero-split__card hero-split__card--placeholder">
            {% render 'icon', name: 'paw' %}
          </div>
        {%- endif -%}

        {%- if section.settings.image_2 != blank -%}
          <div class="hero-split__card hero-split__card--secondary">
            <img
              src="{{ section.settings.image_2 | image_url: width: 500 }}"
              alt="{{ section.settings.image_2.alt | default: shop.name | escape }}"
              loading="lazy"
              width="500" height="500">
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero split",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow pill",
      "default": "Fourteen illustrated worlds"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Story-print bandanas for"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent (italic)",
      "default": "very good pets"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "From botanical blooms to celestial skies — illustrated, made-to-order bandanas for dogs and cats, printed in fourteen little worlds."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop bestsellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label",
      "default": "Explore the worlds"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image",
      "info": "A bright photo of a pet wearing a bandana (900 x 990px+)."
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Secondary image (overlapping)"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Floating badge",
      "default": "Printed to order in the UK"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Trust chip",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "paw", "label": "Paw" },
            { "value": "heart", "label": "Heart" },
            { "value": "truck", "label": "Truck" },
            { "value": "wash", "label": "Water drop" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "star", "label": "Star" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "paw"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Made to order"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero split",
      "blocks": [
        { "type": "chip", "settings": { "icon": "heart", "text": "Made to order" } },
        { "type": "chip", "settings": { "icon": "wash", "text": "Machine washable" } },
        { "type": "chip", "settings": { "icon": "truck", "text": "Free UK shipping £50+" } }
      ]
    }
  ]
}
{% endschema %}
