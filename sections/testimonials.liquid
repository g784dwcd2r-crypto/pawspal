<section class="section{% if section.settings.background == 'band' %} section--band{% endif %}">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="testimonials">
      {%- for block in section.blocks -%}
        <div class="testimonial" {{ block.shopify_attributes }}>
          <div class="testimonial__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
            {%- for i in (1..block.settings.stars) -%}
              {% render 'icon', name: 'star' %}
            {%- endfor -%}
          </div>
          <p class="testimonial__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <p class="testimonial__author">{{ block.settings.author }}</p>
          {%- if block.settings.detail != blank -%}
            <p class="testimonial__detail">{{ block.settings.detail }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wag-worthy reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 10,000+ good dogs"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "band", "label": "Blush band" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The quality is incredible and my pup looks adorable. We get compliments on every walk!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "default": "with Biscuit, Golden Retriever"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "The quality is incredible and my pup looks adorable. We get compliments on every walk!", "author": "Sarah M.", "detail": "with Biscuit, Golden Retriever" } },
        { "type": "testimonial", "settings": { "quote": "Finally, a collar that survives our lake days and still looks brand new. Worth every penny.", "author": "Jordan T.", "detail": "with Luna, Border Collie" } },
        { "type": "testimonial", "settings": { "quote": "Knowing every order feeds a shelter dog makes shopping here feel extra good.", "author": "Priya K.", "detail": "with Mochi, Corgi" } }
      ]
    }
  ]
}
{% endschema %}
