<div class="cart-drawer" id="CartDrawer" role="dialog" aria-label="Shopping cart">
  <div class="cart-drawer__head">
    <h3>Your cart ({{ cart.item_count }})</h3>
    <button class="header-icon" data-close-panel aria-label="Close cart">
      {% render 'icon', name: 'close' %}
    </button>
  </div>

  {%- if cart.item_count > 0 -%}
    {%- assign threshold = settings.free_shipping_threshold | times: 100 -%}
    {%- if settings.free_shipping_threshold > 0 -%}
      <div class="cart-drawer__body" style="flex: 0 0 auto; padding-top: 1.6rem;">
        {%- if cart.total_price >= threshold -%}
          <div class="shipping-bar shipping-bar--done">
            <p class="shipping-bar__label">You've unlocked free shipping!</p>
            <div class="shipping-bar__track"><div class="shipping-bar__fill" style="width: 100%;"></div></div>
          </div>
        {%- else -%}
          {%- assign remaining = threshold | minus: cart.total_price -%}
          {%- assign progress = cart.total_price | times: 100 | divided_by: threshold -%}
          <div class="shipping-bar">
            <p class="shipping-bar__label">You're {{ remaining | money }} away from free shipping</p>
            <div class="shipping-bar__track"><div class="shipping-bar__fill" style="width: {{ progress }}%;"></div></div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cart-drawer__body">
      {%- for item in cart.items -%}
        <div class="cart-line">
          <a href="{{ item.url }}" class="cart-line__media">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" loading="lazy" width="100" height="100">
            {%- endif -%}
          </a>
          <div>
            <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
            {%- unless item.product.has_only_default_variant -%}
              <p class="cart-line__variant">{{ item.variant.title }}</p>
            {%- endunless -%}
            {%- for property in item.properties -%}
              {%- assign pfirst = property.first | slice: 0 -%}
              {%- if property.last != blank and pfirst != '_' -%}
                <p class="cart-line__variant">{{ property.first }}: {{ property.last | truncate: 90 }}</p>
              {%- endif -%}
            {%- endfor -%}
            {%- for discount in item.line_level_discount_allocations -%}
              <p class="cart-line__variant">{{ discount.discount_application.title }}</p>
            {%- endfor -%}
            <div class="cart-line__controls">
              <div class="quantity">
                <button type="button" data-qty-change="-1" aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
                <input type="number" value="{{ item.quantity }}" min="0" data-cart-line-qty="{{ forloop.index }}" aria-label="Quantity">
                <button type="button" data-qty-change="1" aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
              </div>
              <a href="{{ item.url_to_remove }}" class="cart-line__remove" data-cart-remove="{{ forloop.index }}" aria-label="Remove {{ item.product.title | escape }}">
                {% render 'icon', name: 'trash' %}
              </a>
            </div>
            <p class="cart-line__price" style="margin: .8rem 0 0;">{{ item.final_line_price | money }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="cart-drawer__foot">
      <div class="cart-summary__row cart-summary__row--total" style="margin-top: 0; border: none; padding-top: 0;">
        <span>Subtotal</span>
        <span>{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-summary__note">Shipping, taxes, and discounts calculated at checkout.</p>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="btn btn--primary btn--full">Checkout</button>
      </form>
      <a href="{{ routes.cart_url }}" class="account-links" style="display:block; text-align:center; margin-top:1.2rem;">View cart</a>
      {%- if settings.cart_giveback_text != blank -%}
        <p class="cart-drawer__giveback">{{ settings.cart_giveback_text }}</p>
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="cart-drawer__empty">
      {% render 'icon', name: 'paw' %}
      <h3>Your cart is empty</h3>
      <p>Your pup deserves something special.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" data-close-panel>Start shopping</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
