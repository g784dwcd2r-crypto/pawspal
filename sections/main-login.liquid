<div class="page-width account-page">
  <h1>Welcome back</h1>

  <div class="account-card">
    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <p class="form-message form-message--error">Incorrect email or password. Please try again.</p>
      {%- endif -%}
      <div class="field">
        <label for="CustomerEmail">Email</label>
        <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="CustomerPassword">Password</label>
        <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--full">Sign in</button>
    {%- endform -%}

    <details style="margin-top: 2rem;">
      <summary style="cursor: pointer; font-weight: 700;">Forgot your password?</summary>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" style="margin-top: 1.2rem;">If that email exists, we've sent a reset link.</p>
        {%- else -%}
          <div class="field" style="margin-top: 1.6rem;">
            <label for="RecoverEmail">Email</label>
            <input type="email" id="RecoverEmail" name="email" autocomplete="email" required>
          </div>
          <button type="submit" class="btn btn--outline">Send reset link</button>
        {%- endif -%}
      {%- endform -%}
    </details>
  </div>

  <p class="account-links">
    New around here? <a href="{{ routes.account_register_url }}">Create an account</a>
  </p>
</div>

{% schema %}
{
  "name": "Login",
  "settings": []
}
{% endschema %}
