{%- if section.blocks.size > 0 -%}
<div class="announcement-bar{% if section.settings.color_scheme == 'accent' %} announcement-bar--accent{% endif %}">
  <div class="page-width announcement-bar__inner">
    {%- for block in section.blocks -%}
      <p class="announcement-bar__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </p>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "primary", "label": "Navy" },
        { "value": "accent", "label": "Blush" }
      ],
      "default": "primary"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "🐾 Free U.S. shipping on orders $50+"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "announcement", "settings": { "text": "🐾 Free U.S. shipping on orders $50+" } },
      { "type": "announcement", "settings": { "text": "❤️ Every order donates a meal to a shelter dog" } }
    ]
  }
}
{% endschema %}
