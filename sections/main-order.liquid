<div class="page-width account-page account-page--wide">
  <h1>Order {{ order.name }}</h1>
  <p class="text-center" style="margin-bottom: 3.6rem;">
    Placed {{ order.created_at | date: '%B %d, %Y' }} · <a href="{{ routes.account_url }}">Back to account</a>
  </p>

  <div class="account-card" style="margin-bottom: 2.4rem;">
    <div style="overflow-x: auto;">
      <table class="account-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Qty</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr>
              <td>
                {{ line_item.title }}
                {%- if line_item.fulfillment.tracking_number -%}
                  <br><small>Tracking: <a href="{{ line_item.fulfillment.tracking_url }}" target="_blank" rel="noopener">{{ line_item.fulfillment.tracking_number }}</a></small>
                {%- endif -%}
              </td>
              <td>{{ line_item.final_price | money }}</td>
              <td>{{ line_item.quantity }}</td>
              <td>{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr><td colspan="3">Subtotal</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
          {%- for shipping_method in order.shipping_methods -%}
            <tr><td colspan="3">Shipping ({{ shipping_method.title }})</td><td>{{ shipping_method.price | money }}</td></tr>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <tr><td colspan="3">Tax ({{ tax_line.title }})</td><td>{{ tax_line.price | money }}</td></tr>
          {%- endfor -%}
          <tr><td colspan="3"><strong>Total</strong></td><td><strong>{{ order.total_price | money }}</strong></td></tr>
        </tfoot>
      </table>
    </div>
  </div>

  {%- if order.shipping_address -%}
    <div class="account-card">
      <h4>Shipping address</h4>
      <p style="margin: 0;">{{ order.shipping_address | format_address }}</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Order",
  "settings": []
}
{% endschema %}
