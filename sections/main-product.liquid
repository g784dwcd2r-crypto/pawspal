{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="page-width">
  {% render 'breadcrumbs' %}
  <div class="product-page">

    <div class="product-gallery">
      <div class="product-gallery__main">
        {%- assign featured = current_variant.featured_image | default: product.featured_image -%}
        {%- if featured -%}
          <img
            data-main-image
            src="{{ featured | image_url: width: 1000 }}"
            srcset="{{ featured | image_url: width: 600 }} 600w, {{ featured | image_url: width: 1000 }} 1000w, {{ featured | image_url: width: 1600 }} 1600w"
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ featured.alt | default: product.title | escape }}"
            width="1000" height="1000">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="product-gallery__thumbs">
          {%- for image in product.images -%}
            <button
              type="button"
              class="product-gallery__thumb{% if image.src == featured.src %} is-active{% endif %}"
              data-thumb="{{ image | image_url: width: 1000 }}"
              data-thumb-alt="{{ image.alt | default: product.title | escape }}"
              aria-label="View image {{ forloop.index }}">
              <img src="{{ image | image_url: width: 160 }}" alt="" loading="lazy" width="76" height="76">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info" data-product-form-wrapper>
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="product-info__vendor">{{ product.vendor }}</p>
      {%- endif -%}

      <h1 class="product-info__title">{{ product.title }}</h1>

      <div class="product-info__price" data-product-price>
        {% render 'price', variant: current_variant %}
      </div>

      {%- form 'product', product, data-ajax-cart: '' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="option-group" style="border:none; padding:0; margin-left:0; margin-right:0;">
              <legend class="option-group__label">
                {{ option.name }}: <span data-selected-value>{{ option.selected_value }}</span>
              </legend>
              <div class="option-pills">
                {%- for value in option.values -%}
                  <div class="option-pill">
                    <input
                      type="radio"
                      id="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                      name="option-{{ section.id }}-{{ forloop.parentloop.index0 }}"
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}>
                    <label for="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}">{{ value }}</label>
                  </div>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        <div class="quantity-row">
          <div class="quantity">
            <button type="button" data-qty-change="-1" aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="Quantity">
            <button type="button" data-qty-change="1" aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
          </div>
        </div>

        <div class="product-form__buttons">
          <button
            type="submit"
            class="btn btn--primary btn--full"
            data-add-to-cart
            data-add-label="Add to cart"
            {% unless current_variant.available %}disabled{% endunless %}>
            <span data-add-to-cart-text>
              {%- if current_variant.available %}Add to cart{% else %}Sold out{% endif -%}
            </span>
          </button>
          {%- if section.settings.show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>
      {%- endform -%}

      {%- if section.settings.giveback_text != blank -%}
        <div class="product-info__giveback">
          {% render 'icon', name: 'heart' %}
          <span>{{ section.settings.giveback_text }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank or section.settings.trust_3 != blank -%}
        <div class="product-trust">
          {%- if section.settings.trust_1 != blank -%}
            <span>{% render 'icon', name: 'heart' %} {{ section.settings.trust_1 }}</span>
          {%- endif -%}
          {%- if section.settings.trust_2 != blank -%}
            <span>{% render 'icon', name: 'wash' %} {{ section.settings.trust_2 }}</span>
          {%- endif -%}
          {%- if section.settings.trust_3 != blank -%}
            <span>{% render 'icon', name: 'truck' %} {{ section.settings.trust_3 }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if product.description != blank -%}
        <div class="product-info__description rte">{{ product.description }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="product-accordions">
          {%- for block in section.blocks -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title }} {% render 'icon', name: 'chevron-down' %}</summary>
              <div class="product-accordions__content rte">{{ block.settings.content }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <script type="application/json" data-variant-json>
        [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id }},
              "options": {{ variant.options | json }},
              "price": {{ variant.price | json }},
              "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
              "available": {{ variant.available | json }},
              "featured_image": {% if variant.featured_image %}{ "src": {{ variant.featured_image | image_url: width: 1000 | json }}, "alt": {{ variant.featured_image.alt | json }} }{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": true
    },
    {
      "type": "text",
      "id": "giveback_text",
      "label": "Give-back message",
      "default": "Printed to order for your very good pet 🐾"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust chip 1 (heart icon)",
      "default": "Made to order"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust chip 2 (wash icon)",
      "default": "Machine washable"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust chip 3 (truck icon)",
      "default": "Free UK shipping £50+"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping & returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Free U.S. shipping on orders over $50. Easy 30-day returns on unused items.</p>"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "accordion", "settings": { "title": "Sizing guide", "content": "<p>Measure around your dog's neck where the collar naturally sits, then add two fingers of room for comfort.</p>" } },
      { "type": "accordion", "settings": { "title": "Care instructions", "content": "<p>Machine wash cold on gentle, lay flat to dry. Built for muddy adventures.</p>" } },
      { "type": "accordion", "settings": { "title": "Shipping & returns", "content": "<p>Free U.S. shipping on orders over $50. Easy 30-day returns on unused items.</p>" } }
    ]
  }
}
{% endschema %}
