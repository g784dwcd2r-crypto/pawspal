{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="page-width">
  <div class="product-page">

    <div class="product-gallery">
      <div class="product-gallery__main">
        {%- assign featured = current_variant.featured_image | default: product.featured_image -%}
        {%- if featured -%}
          <img
            data-main-image
            src="{{ featured | image_url: width: 1000 }}"
            srcset="{{ featured | image_url: width: 600 }} 600w, {{ featured | image_url: width: 1000 }} 1000w, {{ featured | image_url: width: 1600 }} 1600w"
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ featured.alt | default: product.title | escape }}"
            width="1000" height="1000">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="product-gallery__thumbs">
          {%- for image in product.images -%}
            <button
              type="button"
              class="product-gallery__thumb{% if image.src == featured.src %} is-active{% endif %}"
              data-thumb="{{ image | image_url: width: 1000 }}"
              data-thumb-srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 1000 }} 1000w, {{ image | image_url: width: 1600 }} 1600w"
              data-thumb-alt="{{ image.alt | default: product.title | escape }}"
              aria-label="View image {{ forloop.index }}">
              <img src="{{ image | image_url: width: 160 }}" alt="" loading="lazy" width="76" height="76">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info" data-product-form-wrapper>
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="product-info__vendor">{{ product.vendor }}</p>
      {%- endif -%}

      <h1 class="product-info__title">{{ product.title }}</h1>

      <div class="product-info__price" data-product-price>
        {% render 'price', variant: current_variant %}
      </div>

      {%- form 'product', product, data-ajax-cart: '' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="option-group" style="border:none; padding:0; margin-left:0; margin-right:0;">
              <legend class="option-group__label">
                {{ option.name }}: <span data-selected-value>{{ option.selected_value }}</span>
              </legend>
              <div class="option-pills">
                {%- for value in option.values -%}
                  <div class="option-pill">
                    <input
                      type="radio"
                      id="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                      name="option-{{ section.id }}-{{ forloop.parentloop.index0 }}"
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}>
                    <label for="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}">{{ value }}</label>
                  </div>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        <div class="quantity-row">
          <div class="quantity">
            <button type="button" data-qty-change="-1" aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="Quantity">
            <button type="button" data-qty-change="1" aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
          </div>
        </div>

        {%- liquid
          assign show_commission = false
          if section.settings.enable_commission
            assign tag_setting = section.settings.commission_tags | default: ''
            assign tag_list = tag_setting | downcase | split: ','
            if tag_list.size == 0
              assign show_commission = true
            else
              assign ptags = product.tags | join: ',' | downcase | split: ','
              for t in tag_list
                assign tt = t | strip
                if ptags contains tt
                  assign show_commission = true
                endif
              endfor
            endif
          endif
        -%}
        {%- if show_commission -%}
          <div class="commission-fields" style="margin: 2rem 0 .4rem;">
            {%- if section.settings.name_label != blank -%}
              <div class="field">
                <label for="CommissionName-{{ section.id }}">{{ section.settings.name_label }} <span style="font-weight: 400; opacity: .65;">(optional)</span></label>
                <input type="text" id="CommissionName-{{ section.id }}" name="properties[Pet's name]" maxlength="60" autocomplete="off">
              </div>
            {%- endif -%}
            {%- if section.settings.ig_label != blank -%}
              <div class="field">
                <label for="CommissionIG-{{ section.id }}">{{ section.settings.ig_label }} <span style="font-weight: 400; opacity: .65;">(optional)</span></label>
                <input type="text" id="CommissionIG-{{ section.id }}" name="properties[Instagram]" maxlength="40" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="@yourhandle">
              </div>
            {%- endif -%}
            {%- if section.settings.notes_label != blank -%}
              <div class="field" style="margin-bottom: .6rem;">
                <label for="CommissionNotes-{{ section.id }}">{{ section.settings.notes_label }} <span style="font-weight: 400; opacity: .65;">(optional)</span></label>
                <textarea id="CommissionNotes-{{ section.id }}" name="properties[Commission notes]" rows="4" maxlength="1200" placeholder="{{ section.settings.notes_placeholder | escape }}"></textarea>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="product-form__buttons">
          <button
            type="submit"
            class="btn btn--primary btn--full"
            data-add-to-cart
            data-add-label="Add to cart"
            {% unless current_variant.available %}disabled{% endunless %}>
            <span data-add-to-cart-text>
              {%- if current_variant.available %}Add to cart{% else %}Sold out{% endif -%}
            </span>
          </button>
          {%- if section.settings.show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>
      {%- endform -%}

      {%- if section.settings.giveback_text != blank -%}
        <div class="product-info__giveback">
          {% render 'icon', name: 'heart' %}
          <span>{{ section.settings.giveback_text }}</span>
        </div>
      {%- endif -%}

      {%- if product.description != blank -%}
        <div class="product-info__description rte">{{ product.description }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="product-accordions">
          {%- for block in section.blocks -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title }} {% render 'icon', name: 'chevron-down' %}</summary>
              <div class="product-accordions__content rte">{{ block.settings.content }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <script type="application/json" data-variant-json>
        [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id }},
              "options": {{ variant.options | json }},
              "price": {{ variant.price | json }},
              "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
              "available": {{ variant.available | json }},
              "featured_image": {% if variant.featured_image %}{ "src": {{ variant.featured_image | image_url: width: 1000 | json }}, "srcset": {% capture variant_srcset %}{{ variant.featured_image | image_url: width: 600 }} 600w, {{ variant.featured_image | image_url: width: 1000 }} 1000w, {{ variant.featured_image | image_url: width: 1600 }} 1600w{% endcapture %}{{ variant_srcset | json }}, "alt": {{ variant.featured_image.alt | json }} }{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": true
    },
    {
      "type": "text",
      "id": "giveback_text",
      "label": "Give-back message",
      "default": "This purchase donates a meal to a shelter dog."
    },
    {
      "type": "header",
      "content": "Commission fields"
    },
    {
      "type": "checkbox",
      "id": "enable_commission",
      "label": "Show commission fields",
      "info": "Adds a name field and a notes box; answers are attached to the order line.",
      "default": true
    },
    {
      "type": "text",
      "id": "commission_tags",
      "label": "Show only for products tagged",
      "info": "Comma-separated tags. Leave blank to show on every product.",
      "default": "custom, personalised, commission, fullview"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name field label",
      "default": "Your pet's name"
    },
    {
      "type": "text",
      "id": "ig_label",
      "label": "Instagram field label",
      "info": "Saved on the order line so you can see who placed it. Leave blank to hide the field.",
      "default": "Your Instagram (so we can tag your pet's portrait)"
    },
    {
      "type": "text",
      "id": "notes_label",
      "label": "Notes field label",
      "default": "Commission notes (tell us exactly what you want)"
    },
    {
      "type": "textarea",
      "id": "notes_placeholder",
      "label": "Notes placeholder",
      "default": "Breed, markings, personality, the pose or view you'd like, background ideas, colours to use or avoid…"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping & returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Free U.S. shipping on orders over $50. Easy 30-day returns on unused items.</p>"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "accordion", "settings": { "title": "Sizing guide", "content": "<p>Measure around your dog's neck where the collar naturally sits, then add two fingers of room for comfort.</p>" } },
      { "type": "accordion", "settings": { "title": "Care instructions", "content": "<p>Machine wash cold on gentle, lay flat to dry. Built for muddy adventures.</p>" } },
      { "type": "accordion", "settings": { "title": "Shipping & returns", "content": "<p>Free U.S. shipping on orders over $50. Easy 30-day returns on unused items.</p>" } }
    ]
  }
}
{% endschema %}
