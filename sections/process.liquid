<section class="section section--band">
  <div class="page-width">
    <div class="section-header" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="process">
      {%- for block in section.blocks -%}
        <div class="process__step" data-reveal style="--reveal-delay: {{ forloop.index0 | times: 90 }}ms;" {{ block.shopify_attributes }}>
          <span class="process__num process__num--{{ forloop.index }}">{{ forloop.index }}</span>
          <h3 class="h4">{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
        {%- unless forloop.last -%}
          <div class="process__arrow" aria-hidden="true">{% render 'icon', name: 'arrow-right' %}</div>
        {%- endunless -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="text-center" style="margin-top: 3.6rem;" data-reveal>
        <a href="{{ section.settings.button_link }}" class="btn btn--accent">{{ section.settings.button_label }} {% render 'icon', name: 'arrow-right' %}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From photo to masterpiece" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How a commission works" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start a commission" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Send a photo" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "One good photo is all we need — daylight, both eyes visible." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "heading": "Send a photo", "text": "One good photo is all we need — daylight, both eyes visible." } },
        { "type": "step", "settings": { "heading": "We illustrate", "text": "Our artists draw your pet by hand — sketched, refined and coloured individually." } },
        { "type": "step", "settings": { "heading": "Made & delivered", "text": "Printed to order in the UK, or delivered as a download — ready to wag." } }
      ]
    }
  ]
}
{% endschema %}
