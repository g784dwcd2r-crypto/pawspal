<div class="password-page">
  <div class="password-page__box">
    <span class="eyebrow">Coming soon</span>
    <h1>{{ shop.name }}</h1>
    <p>{{ section.settings.text }}</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="form-message form-message--error">Wrong password. Give it another try.</p>
      {%- endif -%}
      <input type="password" name="password" placeholder="Store password" aria-label="Password" required>
      <button type="submit" class="btn btn--primary">Enter</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Something pawsome is on the way. We're putting the finishing touches on the shop, so check back soon."
    }
  ]
}
{% endschema %}
