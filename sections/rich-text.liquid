<section class="section{% if section.settings.background == 'band' %} section--band{% endif %}">
  <div class="page-width">
    <div class="section-header" style="margin-bottom: 0;">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <p style="margin-top: 2.4rem;"><a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_label }}</a></p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for good dogs"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Use this space to tell your brand story: why you started, what makes your products special and the pets who inspired it all.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "band", "label": "Blush band" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    { "name": "Rich text" }
  ]
}
{% endschema %}
