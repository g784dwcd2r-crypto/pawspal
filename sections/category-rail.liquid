<section class="section">
  <div class="page-width">
    <div class="section-row" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.show_view_all -%}
        <a href="{{ routes.collections_url }}" class="link-arrow section-row__link">View all {% render 'icon', name: 'arrow-right' %}</a>
      {%- endif -%}
    </div>

    <div class="category-rail" data-reveal style="--reveal-delay: 100ms;">
      <div class="category-rail__arrows">
        <button type="button" class="category-rail__arrow" data-rail-scroll="prev" aria-label="Scroll back">
          {% render 'icon', name: 'chevron-left' %}
        </button>
        <button type="button" class="category-rail__arrow" data-rail-scroll="next" aria-label="Scroll forward">
          {% render 'icon', name: 'chevron-right' %}
        </button>
      </div>

      <div class="category-rail__track">
        {%- for block in section.blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            assign title = block.settings.title | default: collection.title | default: 'Collection'
            assign url = collection.url | default: routes.collections_url
            assign image = block.settings.image | default: collection.featured_image | default: collection.products.first.featured_image
            assign tone = forloop.index0 | modulo: 6
          -%}
          <a href="{{ url }}" class="category-rail__item" {{ block.shopify_attributes }}>
            <span class="category-rail__media{% unless image %} rail-tone-{{ tone }}{% endunless %}">
              {%- if image -%}
                <img
                  src="{{ image | image_url: width: 400 }}"
                  srcset="{{ image | image_url: width: 300 }} 300w, {{ image | image_url: width: 400 }} 400w"
                  sizes="175px"
                  alt="{{ title | escape }}"
                  loading="lazy"
                  width="400" height="400">
              {%- else -%}
                <svg class="rail-paw" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><ellipse cx="6.2" cy="9.2" rx="1.9" ry="2.4"/><ellipse cx="10.4" cy="6.2" rx="2" ry="2.5"/><ellipse cx="15.1" cy="6.6" rx="2" ry="2.5"/><ellipse cx="18.8" cy="10.2" rx="1.9" ry="2.3"/><path d="M12.6 10.4c2.9 0 5.9 3.1 5.9 5.9 0 1.9-1.5 3.3-3.4 3.3-1 0-1.8-.5-2.7-.5s-1.7.5-2.7.5c-1.9 0-3.4-1.4-3.4-3.3 0-2.8 3.4-5.9 6.3-5.9z"/></svg>
              {%- endif -%}
            </span>
            <span class="category-rail__title">{{ title }}</span>
            {%- if section.settings.show_count and collection != blank -%}
              <span class="category-rail__count">
                {%- if collection.products_count > 0 -%}
                  {{ collection.products_count }} print{% if collection.products_count != 1 %}s{% endif %}
                {%- else -%}
                  Coming soon
                {%- endif -%}
              </span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection rail",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the worlds"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"view all\" link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title",
          "info": "Leave blank to use the collection title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Leave blank to use the collection image (falls back to its first product)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection rail",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
