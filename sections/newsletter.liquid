<section class="section newsletter">
  <div class="page-width">
    <div class="newsletter__box">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" style="width: 100%;">Thanks for joining the studio. Check your inbox.</p>
        {%- else -%}
          <input
            type="email"
            name="contact[email]"
            placeholder="Your email address"
            aria-label="Email address"
            autocomplete="email"
            pattern="[^@\s]+@[^@\s]+\.[A-Za-z]{2,}"
            title="Please enter a full email address, like name@example.com"
            required>
          <button type="submit" class="btn btn--primary">{{ section.settings.button_label }}</button>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="form-message form-message--error" style="width: 100%;">Please enter a valid email address.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Join the studio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first order"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "New drops, exclusive offers and very good pet art. No spam, paw promise."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
