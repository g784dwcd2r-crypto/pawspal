<div class="marquee marquee--{{ section.settings.color_scheme }}" aria-hidden="true">
  <div class="marquee__track">
    {%- for i in (1..2) -%}
      <span class="marquee__item">
        {%- for j in (1..6) -%}
          {{ section.settings.text }} {% render 'icon', name: 'paw' %}
        {%- endfor -%}
      </span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Scrolling text",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Sit. Stay. Shop."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "primary", "label": "Navy" },
        { "value": "accent", "label": "Blush" },
        { "value": "soft", "label": "Soft blush" }
      ],
      "default": "primary"
    }
  ],
  "presets": [
    { "name": "Scrolling text" }
  ]
}
{% endschema %}
