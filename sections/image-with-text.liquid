<section class="section{% if section.settings.background == 'band' %} section--band{% endif %}">
  <div class="page-width">
    <div class="image-with-text{% if section.settings.layout == 'text_first' %} image-with-text--flip{% endif %}">
      <div class="image-with-text__media" data-reveal>
        <div class="image-with-text__frame">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1000 }}"
              srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1000 }} 1000w, {{ section.settings.image | image_url: width: 1400 }} 1400w"
              sizes="(min-width: 990px) 50vw, 100vw"
              alt="{{ section.settings.image.alt | escape }}"
              loading="lazy"
              width="1000" height="850">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if section.settings.stat_number != blank -%}
          <div class="image-with-text__stat">
            <strong>{{ section.settings.stat_number }}</strong>
            <span>{{ section.settings.stat_label }}</span>
          </div>
        {%- endif -%}
      </div>
      <div class="image-with-text__content" data-reveal style="--reveal-delay: 120ms;">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_label }} {% render 'icon', name: 'arrow-right' %}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first" }
      ],
      "default": "image_first"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every print tells a story"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every bandana is inspired by the meaning of flowers and the little worlds pets live in — printed to order, tied with love, and ready for the next adventure.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "Floating stat number",
      "default": "14",
      "info": "Leave blank to hide the floating card."
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "Floating stat label",
      "default": "illustrated worlds"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "band", "label": "Blush band" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    { "name": "Image with text" }
  ]
}
{% endschema %}
