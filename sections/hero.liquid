{%- liquid
  case section.settings.height
    when 'small'
      assign height = '42rem'
    when 'large'
      assign height = '68rem'
    when 'full'
      assign height = 'calc(100vh - 12rem)'
    else
      assign height = '56rem'
  endcase
-%}

<section
  class="hero{% if section.settings.image != blank %} hero--light{% else %} hero--placeholder{% endif %}{% if section.settings.alignment == 'center' %} hero--center{% endif %}"
  style="--hero-height: {{ height }}; --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">

  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      <img
        src="{{ section.settings.image | image_url: width: 1800 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2200 }} 2200w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        fetchpriority="high"
        width="1800" height="1000">
    </div>
  {%- endif -%}

  <div class="page-width">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="hero__text">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--accent">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 }}" class="btn {% if section.settings.image != blank %}btn--light{% else %}btn--outline{% endif %}">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "A bright lifestyle photo of a dog works best (2200 x 1200px+)."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Image overlay darkness",
      "default": 25
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Spoil your best friend"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Funky custom art of your pets and people, drawn by hand from your photos."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop bestsellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label",
      "default": "Shop new arrivals"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    }
  ],
  "presets": [
    { "name": "Hero banner" }
  ]
}
{% endschema %}
