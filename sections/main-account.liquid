<div class="page-width account-page account-page--wide">
  <h1>Hi, {{ customer.first_name | default: 'friend' }}</h1>
  <p class="text-center" style="margin-bottom: 3.6rem;">
    <a href="{{ routes.account_addresses_url }}">Manage addresses ({{ customer.addresses_count }})</a>
    &nbsp;·&nbsp;
    <a href="{{ routes.account_logout_url }}">Log out</a>
  </p>

  <div class="account-card">
    <h3>Order history</h3>
    {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        <div style="overflow-x: auto;">
          <table class="account-table">
            <thead>
              <tr>
                <th>Order</th>
                <th>Date</th>
                <th>Payment</th>
                <th>Fulfillment</th>
                <th>Total</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p>You haven't placed any orders yet.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Start shopping</a>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Account",
  "settings": []
}
{% endschema %}
