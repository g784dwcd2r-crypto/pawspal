[
  {
    "name": "theme_info",
    "theme_name": "Good Dog",
    "theme_version": "1.1.0",
    "theme_author": "Cleaningclockin",
    "theme_documentation_url": "https://github.com/g784dwcd2r-crypto/Cleaningclockin",
    "theme_support_url": "https://github.com/g784dwcd2r-crypto/Cleaningclockin"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#FCF6EA"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Cards & surfaces",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text (ink)",
        "default": "#2B2118"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (buttons & links)",
        "default": "#2B2118"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (coral)",
        "default": "#E4573D"
      },
      {
        "type": "color",
        "id": "color_accent_soft",
        "label": "Accent soft (tints & bands)",
        "default": "#FAE3D3"
      },
      {
        "type": "color",
        "id": "color_highlight",
        "label": "Highlight (mustard)",
        "default": "#E9A820"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale badge",
        "default": "#E4573D"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "fraunces_n5",
        "info": "A warm, characterful serif gives the artist-studio feel."
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "karla_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1240
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 28,
        "step": 2,
        "unit": "px",
        "label": "Corner radius (cards & images)",
        "default": 6
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_secondary_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_quick_add",
        "label": "Show quick add button",
        "default": true
      },
      {
        "type": "range",
        "id": "new_badge_days",
        "min": 0,
        "max": 60,
        "step": 5,
        "label": "Show \"New\" badge for products created within (days)",
        "info": "Set to 0 to disable.",
        "default": 30
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "min": 0,
        "max": 200,
        "step": 5,
        "label": "Free shipping threshold",
        "info": "Shown as a progress bar in the cart. Set to 0 to hide.",
        "default": 50
      },
      {
        "type": "checkbox",
        "id": "cart_note_enable",
        "label": "Enable order note",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_giveback_text",
        "label": "Give-back message in cart",
        "default": "🐾 This order donates a meal to a shelter dog."
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/yourstore"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  }
]
