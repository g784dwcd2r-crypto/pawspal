{% doc %}
  @prompt
    can u add a small banner for social media links , i prefer to have icons of instagram , tiktok , threads , X , pinterest , ko-fi , fix the treads icon , and keep same original icons colors
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-social-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px 20px;
    text-align: center;
  }

  .ai-social-banner__container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.spacing }}px;
    flex-wrap: wrap;
  }

  .ai-social-banner__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0;
  }

  .ai-social-banner__links-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_spacing }}px;
  }

  .ai-social-banner__link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .ai-social-banner__link-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
  }

  .ai-social-banner__link-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-social-banner__link-{{ ai_gen_id }}--instagram:hover svg {
    filter: brightness(1.1);
  }

  .ai-social-banner__link-{{ ai_gen_id }}--tiktok:hover svg {
    filter: brightness(1.1);
  }

  .ai-social-banner__link-{{ ai_gen_id }}--threads:hover svg {
    filter: brightness(1.1);
  }

  .ai-social-banner__link-{{ ai_gen_id }}--x:hover svg {
    filter: brightness(0.8);
  }

  .ai-social-banner__link-{{ ai_gen_id }}--pinterest:hover svg {
    filter: brightness(1.1);
  }

  .ai-social-banner__link-{{ ai_gen_id }}--kofi:hover svg {
    filter: brightness(1.1);
  }

  @media screen and (max-width: 749px) {
    .ai-social-banner__container-{{ ai_gen_id }} {
      gap: {{ block.settings.spacing | times: 0.7 }}px;
    }

    .ai-social-banner__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-social-banner__link-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.85 }}px;
      height: {{ block.settings.icon_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-social-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-social-banner__container-{{ ai_gen_id }}">
    {% if block.settings.banner_text != blank %}
      <p class="ai-social-banner__text-{{ ai_gen_id }}">{{ block.settings.banner_text }}</p>
    {% endif %}

    <div class="ai-social-banner__links-{{ ai_gen_id }}">
      {% if block.settings.instagram_url != blank %}
