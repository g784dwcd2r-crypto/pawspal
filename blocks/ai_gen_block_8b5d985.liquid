{% doc %}
  @prompt
    i need a gallery of sliding posters i have , like two rows one and they keep moving the rop row from right to left and the second from left to right  . 6 posters per view top and 6 buttom
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-poster-gallery-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-poster-gallery__row-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    margin-bottom: {{ block.settings.row_gap }}px;
    will-change: transform;
  }

  .ai-poster-gallery__row-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-poster-gallery__row-{{ ai_gen_id }}--top {
    animation: ai-slide-right-to-left-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
  }

  .ai-poster-gallery__row-{{ ai_gen_id }}--bottom {
    animation: ai-slide-left-to-right-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
  }

  .ai-poster-gallery__row-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  .ai-poster-gallery__poster-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.poster_width }}px;
    height: {{ block.settings.poster_height }}px;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    box-shadow: {{ block.settings.shadow_intensity }}px {{ block.settings.shadow_intensity }}px {{ block.settings.shadow_intensity | times: 2 }}px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-poster-gallery__poster-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
    box-shadow: {{ block.settings.shadow_intensity | times: 2 }}px {{ block.settings.shadow_intensity | times: 2 }}px {{ block.settings.shadow_intensity | times: 4 }}px rgba(0, 0, 0, 0.15);
  }

  .ai-poster-gallery__poster-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-poster-gallery__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-poster-gallery__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @keyframes ai-slide-right-to-left-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-{{ block.settings.poster_width }}px * 6 - {{ block.settings.gap }}px * 6));
    }
  }

  @keyframes ai-slide-left-to-right-{{ ai_gen_id }} {
    0% {
      transform: translateX(calc(-{{ block.settings.poster_width }}px * 6 - {{ block.settings.gap }}px * 6));
    }
    100% {
      transform: translateX(0);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-poster-gallery__poster-{{ ai_gen_id }} {
      width: {{ block.settings.poster_width | times: 0.7 }}px;
      height: {{ block.settings.poster_height | times: 0.7 }}px;
    }

    @keyframes ai-slide-right-to-left-{{ ai_gen_id }} {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-{{ block.settings.poster_width | times: 0.7 }}px * 6 - {{ block.settings.gap }}px * 6));
      }
    }

    @keyframes ai-slide-left-to-right-{{ ai_gen_id }} {
      0% {
        transform: translateX(calc(-{{ block.settings.poster_width | times: 0.7 }}px * 6 - {{ block.settings.gap }}px * 6));
      }
      100% {
        transform: translateX(0);
      }
    }
  }
{% endstyle %}

<div class="ai-poster-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-poster-gallery__row-{{ ai_gen_id }} ai-poster-gallery__row-{{ ai_gen_id }}--top">
    {% for i in (1..12) %}
      {% liquid
        assign poster_key = 'top_poster_' | append: i
        assign poster = block.settings[poster_key]
      %}
      <div class="ai-poster-gallery__poster-{{ ai_gen_id }}">
        {% if poster %}
          <img
            src="{{ poster | image_url: width: 800 }}"
            alt="{{ poster.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.poster_width }}"
            height="{{ block.settings.poster_height }}"
          >
        {% else %}
          <div class="ai-poster-gallery__placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="ai-poster-gallery__row-{{ ai_gen_id }} ai-poster-gallery__row-{{ ai_gen_id }}--bottom">
    {% for i in (1..12) %}
      {% liquid
        assign poster_key = 'bottom_poster_' | append: i
        assign poster = block.settings[poster_key]
      %}
      <div class="ai-poster-gallery__poster-{{ ai_gen_id }}">
        {% if poster %}
          <img
            src="{{ poster | image_url: width: 800 }}"
            alt="{{ poster.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.poster_width }}"
            height="{{ block.settings.poster_height }}"
          >
        {% else %}
          <div class="ai-poster-gallery__placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

